{
  "name": "@telltale/web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4280 --strictPort",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:entry": "tsx --test test/entry.test.ts"
  },
  "dependencies": {
    "@telltale/contracts": "workspace:*",
    "pinia": "^3.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.93.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
