{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telltale",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["DEEPSEEK_API_KEY"] },
  "durable_objects": {
    "bindings": [
      { "name": "COURSES", "class_name": "CourseRoom" },
      { "name": "QUOTAS", "class_name": "TrafficQuota" },
    ],
  },
  "migrations": [{ "tag": "v1-courses", "new_sqlite_classes": ["CourseRoom", "TrafficQuota"] }],
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/health/*", "/api", "/api/*"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
